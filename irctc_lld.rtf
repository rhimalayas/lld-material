\
\'a0\'a0\'a0 public synchronized boolean lockSeat(String seatId, String userId) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SeatLock existingLock = lockedSeats.get(seatId);\
\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 if (existingLock != null && !existingLock.isExpired()) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0 return false; // already locked\

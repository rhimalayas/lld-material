\f0\b0\fs24 \cf0 \strokec2 import java.util.*;\
\
interface Observer \{\
\'a0\'a0\'a0 void update(String message);\
\}\
\
class User implements Observer \{\
\'a0\'a0\'a0 private String name;\
\
\'a0\'a0\'a0 public User(String name) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 this.name = name;\
\'a0\'a0\'a0 \}\
\
\'a0\'a0\'a0 public void update(String message) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 System.out.println(name + " received: " + message);\
\'a0\'a0\'a0 \}\
\}\
\
class BookingService \{\
\'a0\'a0\'a0 private List<Observer> observers = new ArrayList<>();\
\
\'a0\'a0\'a0 public void addObserver(Observer o) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 observers.add(o);\
\'a0\'a0\'a0 \}\
\
\'a0\'a0\'a0 public void notifyUsers(String message) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 for (Observer o : observers) \{\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0 o.update(message);\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 \}\
\'a0\'a0\'a0 \}\
\}\

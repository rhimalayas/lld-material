\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SeatLock lock = lockedSeats.get(seatId);\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 return lock != null &&\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0 lock.getUserId().equals(userId) &&\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0 !lock.isExpired();\
